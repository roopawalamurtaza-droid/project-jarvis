# Optional environment credentials; the desktop UI uses Windows DPAPI instead.
# This file is documentation. JARVIS deliberately does not auto-load .env files.
OPENAI_API_KEY=
GEMINI_API_KEY=
# A cloud provider must also be explicitly enabled in Settings. Requests can be billable.
JARVIS_DATA_DIR=
# Optional API bearer token, at least 16 characters; otherwise generated and DPAPI protected.
JARVIS_API_TOKEN=
